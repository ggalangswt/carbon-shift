\set ON_ERROR_STOP on

-- Jalankan dari database postgres: psql -U postgres -d postgres -f carbonshift_modul5.psql
-- Nama tabel "user" diberi tanda petik karena USER adalah kata khusus PostgreSQL.
CREATE DATABASE carbonshift;
\connect carbonshift

-- ERD: USER (1) -> ACTIVITY (N)
CREATE TABLE "user" (
    user_id INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    name VARCHAR(100) NOT NULL,
    email VARCHAR(100) NOT NULL UNIQUE,
    password_hash VARCHAR(255) NOT NULL,
    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE activity (
    activity_id INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    user_id INTEGER NOT NULL REFERENCES "user" (user_id),
    activity_name VARCHAR(100) NOT NULL,
    duration_minutes INTEGER NOT NULL,
    power_consumption_kwh NUMERIC(6,2) NOT NULL,
    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
);

-- ERD: satu data prakiraan dapat menjadi acuan banyak alternatif slot.
CREATE TABLE weather_forecast (
    forecast_id INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    location VARCHAR(100) NOT NULL,
    forecast_date DATE NOT NULL,
    temperature NUMERIC(5,2),
    weather_condition VARCHAR(50),
    solar_potential NUMERIC(5,2),
    retrieved_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
);

-- ERD: ACTIVITY (1) -> TIME_SLOT (N), WEATHER_FORECAST (1) -> TIME_SLOT (N)
CREATE TABLE time_slot (
    timeslot_id INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    activity_id INTEGER NOT NULL REFERENCES activity (activity_id),
    forecast_id INTEGER NOT NULL REFERENCES weather_forecast (forecast_id),
    start_time TIMESTAMP NOT NULL,
    end_time TIMESTAMP NOT NULL,
    green_score NUMERIC(5,2),
    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
);

-- UNIQUE pada timeslot_id menjaga relasi TIME_SLOT (1) -> RECOMMENDATION (0..1).
CREATE TABLE recommendation (
    recommendation_id INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    timeslot_id INTEGER NOT NULL UNIQUE REFERENCES time_slot (timeslot_id),
    explanation TEXT,
    green_score NUMERIC(5,2),
    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
);
